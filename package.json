{
  "name": "@bharathis-canvas/ui-platform",
  "type": "module",
  "version": "2.0.0",
  "description": "Enterprise design system with React, TypeScript, and Tailwind CSS",
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "tailwindcss",
    "typescript"
  ],
  "homepage": "https://rajeshdumpeti.github.io/ui-platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajeshdumpeti/ui-platform"
  },
  "license": "MIT",
  "author": "Rajesh Dumgeti <dumpetirajesh123@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --declaration --declarationMap",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "deploy-storybook": "npm run build-storybook && gh-pages -d storybook-static"
  },
  "main": "./dist/ui-platform.umd.js",
  "module": "./dist/ui-platform.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui-platform.es.js",
      "require": "./dist/ui-platform.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color2k": "^2.0.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.548.0",
    "material-icons": "^1.13.14",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.6",
    "@storybook/react": "^8.4.6",
    "@storybook/react-vite": "^8.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.9.15",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.4"
  }
}
